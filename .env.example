# Panopticon MCP server — MCP tools over the QBN archive.
#
# Secrets on the Pi live in ~/.config/panopticon/mcp.env, outside the repo, so a
# repo move cannot break startup. This file documents the keys.

# --- database -----------------------------------------------------------------
# Always the LOCAL mirror. The remote source of truth is read directly by an
# external service and is never touched by the MCP server.
DB_HOST=127.0.0.1
DB_USER=panopticon_ro
DB_PASSWORD=
DB_DATABASE=panopticon
# DB_POOL_SIZE=10

# --- http ---------------------------------------------------------------------
PORT=3002

# 'stdio' for a local client that spawns the process, 'http' for the
# Streamable HTTP transport. The systemd unit uses http.
MCP_TRANSPORT=http
# Loopback by default: public traffic arrives through a tunnel, so there is no
# reason to be reachable on the LAN.
HOST=127.0.0.1
NODE_ENV=production

# --- public address -----------------------------------------------------------
# The address this server hands out on its install page, and the Host it will
# answer /mcp on. Canonical and configured rather than derived from the request:
# X-Forwarded-Host is client-set, and this value lands in the page's copy button
# and its `claude mcp add` snippet. Unset is fine for local development — the
# page then falls back to the (validated) Host header.
PUBLIC_ORIGIN=https://mcp.nocitponap.com

# Additional accepted Host values, comma-separated. Used for a fallback address
# during a cutover. A non-default port is part of the Host header and must be
# written out.
#ALLOWED_HOSTS=fallback.example.com:10000

# Number of proxy hops to trust — a NUMBER, never `true`. express-rate-limit
# rejects a blanket trust-proxy because it makes the client IP forgeable.
# 0 while reached directly, 1 behind a single tunnel or reverse proxy.
#
# 1 is both correct and the maximum safe value behind Cloudflare Tunnel: the
# chain is client → Cloudflare edge → cloudflared (this host) → 127.0.0.1, and
# Express counts hops inward from the socket, so 1 resolves to the rightmost
# X-Forwarded-For entry — the only one written by something we trust. 2 would
# let any client forge req.ip and make the limiter decorative.
#
# Leaving this at 0 behind a proxy is not a no-op: req.ip becomes the socket
# address, which is always 127.0.0.1, so every client on earth shares one
# rate-limit bucket.
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
# Deliberately generous. Claude Desktop and claude.ai reach a remote MCP server
# from Anthropic's infrastructure, not from each user's machine, so all users
# share a few source IPs and a per-IP limit pools them rather than isolating
# them. A tight number would let a few active people lock everyone else out.
RATE_LIMIT_MAX=600
